# Nusxa oling: cp .env.example .env
# So'ng SECRET_KEY'ni generatsiya qilib joylashtiring:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DB_PATH=family_call.db

# Vergul bilan ajratilgan — frontend qaysi originlardan ochilsa shularni yozing
ALLOWED_ORIGINS=http://localhost:8000,https://your-domain.example
